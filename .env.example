PORT=3000
# Mot de passe de l'espace admin (/admin.html)
ADMIN_PASSWORD=change-moi
# Clé secrète pour signer les jetons de session (longue chaîne aléatoire)
TOKEN_SECRET=remplace-par-une-longue-chaine-aleatoire

# Notifications e-mail Gmail : SMTP_USER = compte expéditeur
SMTP_USER=votre.compte.expediteur@gmail.com
# Mot de passe d'application Google à 16 caractères (pas le mot de passe Gmail)
SMTP_PASS=xxxx xxxx xxxx xxxx
# Boîte de réception où arriveront les messages du formulaire (peut être différente)
MAIL_TO=votre.adresse.de.reception@gmail.com

# Mettre 1 en production derrière un hébergeur / proxy (Render, Railway, Nginx…)
# pour que la limitation de débit voie la vraie IP des visiteurs.
TRUST_PROXY=
# Autre fournisseur que Gmail (ex. Brevo) : décommenter
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# MAIL_FROM=votre.adresse@gmail.com   (expéditeur validé chez le fournisseur)

# Base de données en ligne (Turso). Laisser vide en local pour utiliser server/data/portfolio.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
